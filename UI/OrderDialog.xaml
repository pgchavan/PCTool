<Window x:Class="HPDTool.UI.OrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HPD Tools - Order Elements" Height="300" Width="400">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Parameter -->
        <StackPanel Orientation="Horizontal">
            <Label Content="Parameter:" Width="100"/>
            <ComboBox x:Name="ParamList" Width="240"/>
        </StackPanel>

        <!-- Start -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Label Content="Start No:" Width="100"/>
            <TextBox x:Name="StartBox" Width="240" Text="1"/>
        </StackPanel>

        <!-- Increment -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Label Content="Increment:" Width="100"/>
            <TextBox x:Name="IncBox" Width="240" Text="1"/>
        </StackPanel>

        <!-- Prefix -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Label Content="Prefix:" Width="100"/>
            <TextBox x:Name="PrefixBox" Width="240"/>
        </StackPanel>

        <!-- Suffix -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <Label Content="Suffix:" Width="100"/>
            <TextBox x:Name="SuffixBox" Width="240"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,50,0,0">

            <Button Content="OK"
                    Width="90"
                    Margin="0,0,10,0"
                    Click="OK_Click"/>

            <Button Content="Cancel"
                    Width="90"
                    Click="Cancel_Click"/>

        </StackPanel>

    </Grid>
</Window>