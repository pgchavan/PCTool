<Window x:Class="HPDTool.UI.FiltWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HPD Tools - Purge Filters" Height="350" Width="400">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Unused View Filters:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ListBox x:Name="FilterListBox" SelectionMode="Extended" Height="200" Margin="0,0,0,10"
                     DisplayMemberPath="Name"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" IsDefault="True" Width="80" Height="30" Margin="0,0,5,0"
                        Click="OkButton_Click"/>
                <Button Content="Cancel" IsCancel="True" Width="80" Height="30" Margin="5,0,0,0"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>