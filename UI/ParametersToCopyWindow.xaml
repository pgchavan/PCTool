<Window x:Class="HPDTool.UI.ParametersToCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HPD Tools - Select Parameters to Copy" Height="400" Width="350"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="lstParameters"
                 SelectionMode="Extended"
                 DisplayMemberPath="Definition.Name" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <Button Width="80" Margin="5" Content="OK" Click="Ok_Click" />
            <Button Width="80" Margin="5" Content="Cancel" Click="Cancel_Click" />

        </StackPanel>
    </Grid>
</Window>
